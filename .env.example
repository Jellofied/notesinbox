# GitHub personal access token with 'repo' scope for the private inbox repository
GITHUB_TOKEN=

# GitHub repository details
GITHUB_OWNER=Jellofied
GITHUB_REPO=notesinbox

# Branch to read/write inbox files (defaults to main)
# GITHUB_BRANCH=main

# Paths inside the repository (defaults shown)
# GITHUB_INBOX_PATH=inbox
# GITHUB_ATTACHMENTS_PATH=attachments

# Optional: server timezone (the app also hard-codes Asia/Kolkata)
# TZ=Asia/Kolkata

# Optional: a shared secret to gate API access during development
# INBOX_SECRET=
